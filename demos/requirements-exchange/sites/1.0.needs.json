        "REQ_BTP_CORE_LOAD": {
          "content": "Design constraint: the worst-case load of each core of the processor, the sum over the tasks that run on it of wcet divided by period, shall stay at or below the core's budget, 70 % on Core0 and 60 % on Core1, enforced strictly.",
          "id": "REQ_BTP_CORE_LOAD",
          "swcraft_path": "requirements/REQ_BTP_CORE_LOAD.yaml",
          "tags": [],
          "title": "Each core stays within its load budget",
          "type": "arch_spec"
        },
        "REQ_BTP_DECOMP_MAIN": {
          "asil": "B(D)",
          "content": "B(D) decomposition of REQ_BTP_SAFETY_GOAL, main channel: the sensor measures the brake temperature and the controller applies only the permitted brake action.",
          "derived_from": [
            "REQ_BTP_SAFETY_GOAL"
          ],
          "id": "REQ_BTP_DECOMP_MAIN",
          "swcraft_path": "requirements/REQ_BTP_DECOMP_MAIN.yaml",
          "tags": [],
          "title": "Main channel measures the temperature and applies the brake request",
          "type": "arch_spec"
        },
        "REQ_BTP_DECOMP_MONITOR": {
          "asil": "B(D)",
          "content": "B(D) decomposition of REQ_BTP_SAFETY_GOAL, monitor channel: the thermal protection derates the permitted brake action when the brake temperature rises. The independence a decomposition assumes is not modelled: both channels run in Task_50ms on Core1, and the monitor reads the main channel's brake temperature.",
          "derived_from": [
            "REQ_BTP_SAFETY_GOAL"
          ],
          "id": "REQ_BTP_DECOMP_MONITOR",
          "swcraft_path": "requirements/REQ_BTP_DECOMP_MONITOR.yaml",
          "tags": [],
          "title": "Monitor channel limits the permitted brake action",
          "type": "arch_spec"
        },
        "REQ_BTP_DIAGNOSTICS": {
          "asil": "A",
          "content": "The diagnostics record every thermal protection event and store a snapshot in non-volatile memory.",
          "id": "REQ_BTP_DIAGNOSTICS",
          "swcraft_path": "requirements/REQ_BTP_DIAGNOSTICS.yaml",
          "tags": [],
          "title": "Record thermal protection events",
          "type": "arch_spec"
        },
        "REQ_BTP_EXECUTION_CONTEXT": {
          "content": "Design constraint: the runnables of both decomposed channels shall run in a partition rated at least ASIL B, on a core whose ASIL capability is at least the partition's level, and the memory they use shall be capable of at least ASIL B.",
          "derived_from": [
            "REQ_BTP_DECOMP_MAIN",
            "REQ_BTP_DECOMP_MONITOR"
          ],
          "id": "REQ_BTP_EXECUTION_CONTEXT",
          "swcraft_path": "requirements/REQ_BTP_EXECUTION_CONTEXT.yaml",
          "tags": [],
          "title": "Both channels run in an ASIL B context",
          "type": "arch_spec"
        },
        "REQ_BTP_TEMPERATURE_RANGE": {
          "content": "Design constraint: every interface that carries the brake temperature shall carry it in degrees Celsius over the physical range -40 degC to 1000 degC at a resolution of 0.1 degC, both ends of the range included.",
